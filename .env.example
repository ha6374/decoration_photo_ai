# Decoration Photo AI Filtering & Management Application
# Environment Variables Configuration Example

# Application Settings
APP_ENV=production
LOG_LEVEL=INFO

# Google Drive Cloud Integration (Optional)
# Path to service account JSON credentials
GDRIVE_SERVICE_ACCOUNT_JSON=credentials/gdrive_service_account.json
# Destination Google Drive Folder ID
GDRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Database Override (Optional, defaults to local SQLite decoration_app.db)
# DATABASE_PATH=data/decoration_app.db
